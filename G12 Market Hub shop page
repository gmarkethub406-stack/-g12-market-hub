<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop — G12 Market Hub</title>
  <meta name="description" content="Shop products and services on G12 Market Hub.">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f5f7f6;
      color: #17221c;
      line-height: 1.5;
    }

    header {
      background: #0b7a45;
      color: white;
      padding: 16px 5%;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav {
      max-width: 1200px;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .logo {
      font-size: 22px;
      font-weight: 800;
      white-space: nowrap;
    }

    .nav a {
      color: white;
      text-decoration: none;
      font-weight: 600;
    }

    .container {
      max-width: 1200px;
      margin: auto;
      padding: 30px 5%;
    }

    .hero {
      background: white;
      border-radius: 18px;
      padding: 35px;
      margin-bottom: 25px;
      text-align: center;
      box-shadow: 0 5px 20px rgba(0,0,0,.06);
    }

    .hero h1 {
      font-size: 38px;
      margin-bottom: 10px;
    }

    .hero p {
      color: #66736c;
      margin-bottom: 20px;
    }

    .search {
      width: 100%;
      max-width: 650px;
      padding: 15px 18px;
      border: 1px solid #d7ded9;
      border-radius: 12px;
      font-size: 16px;
      outline: none;
    }

    .search:focus {
      border-color: #0b7a45;
    }

    .categories {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      padding: 5px 0 20px;
    }

    .category {
      border: 1px solid #d7ded9;
      background: white;
      padding: 10px 16px;
      border-radius: 30px;
      cursor: pointer;
      white-space: nowrap;
      font-weight: 600;
    }

    .category.active,
    .category:hover {
      background: #0b7a45;
      color: white;
      border-color: #0b7a45;
    }

    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    select {
      padding: 11px 14px;
      border: 1px solid #d7ded9;
      border-radius: 10px;
      background: white;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .product {
      background: white;
      border-radius: 15px;
      overflow: hidden;
      box-shadow: 0 5px 18px rgba(0,0,0,.06);
      transition: .2s;
    }

    .product:hover {
      transform: translateY(-3px);
    }

    .product-image {
      height: 170px;
      background: #e9f3ed;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 55px;
    }

    .product-content {
      padding: 16px;
    }

    .product-content h3 {
      margin-bottom: 7px;
      font-size: 18px;
    }

    .category-name {
      color: #6c7771;
      font-size: 13px;
      margin-bottom: 8px;
    }

    .price {
      color: #0b7a45;
      font-size: 20px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .btn {
      width: 100%;
      border: none;
      padding: 12px;
      border-radius: 10px;
      cursor: pointer;
      font-weight: 700;
      background: #0b7a45;
      color: white;
    }

    .btn:hover {
      background: #075d35;
    }

    .sell-box {
      background: #10251b;
      color: white;
      margin-top: 40px;
      padding: 30px;
      border-radius: 18px;
      text-align: center;
    }

    .sell-box h2 {
      margin-bottom: 8px;
    }

    .sell-box p {
      color: #d3ded8;
      margin-bottom: 20px;
    }

    .sell-btn {
      display: inline-block;
      background: white;
      color: #0b7a45;
      padding: 12px 20px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 800;
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,.65);
      z-index: 200;
      padding: 20px;
      align-items: center;
      justify-content: center;
    }

    .modal-box {
      background: white;
      width: 100%;
      max-width: 520px;
      border-radius: 18px;
      padding: 25px;
      position: relative;
      max-height: 90vh;
      overflow-y: auto;
    }

    .close {
      position: absolute;
      right: 18px;
      top: 12px;
      border: none;
      background: none;
      font-size: 28px;
      cursor: pointer;
    }

    .modal-box h2 {
      margin: 15px 35px 10px 0;
    }

    .modal-price {
      color: #0b7a45;
      font-size: 25px;
      font-weight: 800;
      margin: 10px 0;
    }

    .modal-info {
      background: #f1f5f2;
      padding: 15px;
      border-radius: 10px;
      margin: 15px 0;
    }

    footer {
      text-align: center;
      padding: 35px 20px;
      color: #69746e;
    }

    @media (max-width: 950px) {
      .products {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (max-width: 700px) {
      .products {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
      }

      .hero {
        padding: 25px 18px;
      }

      .hero h1 {
        font-size: 28px;
      }

      .product-image {
        height: 130px;
      }
    }

    @media (max-width: 450px) {
      .products {
        grid-template-columns: 1fr;
      }

      .nav {
        flex-wrap: wrap;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="nav">
    <div class="logo">G12 Market Hub</div>
    <a href="index.html">Home</a>
  </div>
</header>

<main class="container">

  <section class="hero">
    <h1>Shop the G12 Market</h1>
    <p>Discover products, services and opportunities on G12 Market Hub.</p>
    <input
      id="searchInput"
      class="search"
      type="search"
      placeholder="Search products or services..."
    >
  </section>

  <div class="categories">
    <button class="category active" onclick="filterCategory('All', this)">All</button>
    <button class="category" onclick="filterCategory('Electronics', this)">Electronics</button>
    <button class="category" onclick="filterCategory('Fashion', this)">Fashion</button>
    <button class="category" onclick="filterCategory('Cars & Parts', this)">Cars & Parts</button>
    <button class="category" onclick="filterCategory('Home', this)">Home</button>
    <button class="category" onclick="filterCategory('Agriculture', this)">Agriculture</button>
    <button class="category" onclick="filterCategory('Property', this)">Property</button>
    <button class="category" onclick="filterCategory('Services', this)">Services</button>
  </div>

  <div class="toolbar">
    <strong id="resultCount">8 products</strong>

    <select id="sortSelect" onchange="sortProducts()">
      <option value="default">Sort by</option>
      <option value="low">Price: Low to High</option>
      <option value="high">Price: High to Low</option>
    </select>
  </div>

  <section id="products" class="products"></section>

  <section class="sell-box">
    <h2>Want to sell on G12?</h2>
    <p>List your product or service and connect with potential buyers.</p>
    <a class="sell-btn"
       href="https://wa.me/2348122045380?text=Hello%20G12%20Market%20Hub,%20I%20want%20to%20list%20a%20product%20or%20service."
       target="_blank">
      Sell on G12
    </a>
  </section>

</main>

<footer>
  © 2026 G12 Market Hub — Buy • Sell • Build • Connect
</footer>

<div id="modal" class="modal" onclick="closeModal(event)">
  <div class="modal-box" onclick="event.stopPropagation()">
    <button class="close" onclick="closeModal()">×</button>
    <div id="modalContent"></div>
  </div>
</div>

<script>
  const products = [
    {
      name: "Smartphone & Accessories",
      price: 250000,
      category: "Electronics",
      icon: "📱",
      seller: "G12 Verified Seller",
      location: "Nigeria",
      description: "Quality smartphones and accessories available for buyers."
    },
    {
      name: "Laptop & Computer",
      price: 480000,
      category: "Electronics",
      icon: "💻",
      seller: "G12 Tech Seller",
      location: "Lagos, Nigeria",
      description: "Laptops, computers and technology accessories."
    },
    {
      name: "Fashion Collection",
      price: 45000,
      category: "Fashion",
      icon: "👕",
      seller: "G12 Fashion Seller",
      location: "Enugu, Nigeria",
      description: "Fashion items and clothing for men and women."
    },
    {
      name: "Auto Parts",
      price: 85000,
      category: "Cars & Parts",
      icon: "🚗",
      seller: "G12 Auto Seller",
      location: "Port Harcourt, Nigeria",
      description: "Vehicle parts and automobile accessories."
    },
    {
      name: "Home Appliances",
      price: 120000,
      category: "Home",
      icon: "🏠",
      seller: "G12 Home Seller",
      location: "Abuja, Nigeria",
      description: "Useful appliances and products for your home."
    },
    {
      name: "Farm Produce",
      price: 35000,
      category: "Agriculture",
      icon: "🌾",
      seller: "G12 Farm Seller",
      location: "Enugu, Nigeria",
      description: "Fresh agricultural products and farm produce."
    },
    {
      name: "Land & Property",
      price: 5000000,
      category: "Property",
      icon: "🏡",
      seller: "G12 Property Seller",
      location: "Nigeria",
      description: "Property and land opportunities listed by sellers."
    },
    {
      name: "Professional Services",
      price: 50000,
      category: "Services",
      icon: "🛠️",
      seller: "G12 Service Provider",
      location: "Nigeria",
      description: "Professional services offered by verified providers."
    }
  ];

  let currentCategory = "All";
  let currentProducts = [...products];

  function formatPrice(price) {
    return "₦" + price.toLocaleString("en-NG");
  }

  function displayProducts() {
    const container = document.getElementById("products");
    const search = document.getElementById("searchInput").value.toLowerCase();

    let filtered = currentProducts.filter(product => {
      const matchesCategory =
        currentCategory === "All" ||
        product.category === currentCategory;

      const matchesSearch =
        product.name.toLowerCase().includes(search) ||
        product.category.toLowerCase().includes(search) ||
        product.description.toLowerCase().includes(search);

      return matchesCategory && matchesSearch;
    });

    container.innerHTML = "";

    if (filtered.length === 0) {
      container.innerHTML =
        '<p style="grid-column:1/-1;text-align:center;padding:40px;">No products found.</p>';
    }

    filtered.forEach((product, index) => {
      container.innerHTML += `
        <article class="product">
          <div class="product-image">${product.icon}</div>

          <div class="product-content">
            <div class="category-name">${product.category}</div>
            <h3>${product.name}</h3>
            <div class="price">${formatPrice(product.price)}</div>

            <button class="btn" onclick="showProduct(${products.indexOf(product)})">
              View Details
            </button>
          </div>
        </article>
      `;
    });

    document.getElementById("resultCount").textContent =
      filtered.length + (filtered.length === 1 ? " product" : " products");
  }

  function filterCategory(category, button) {
    currentCategory = category;

    document.querySelectorAll(".category").forEach(btn => {
      btn.classList.remove("active");
    });

    button.classList.add("active");
    displayProducts();
  }

  function sortProducts() {
    const sort = document.getElementById("sortSelect").value;

    if (sort === "low") {
      currentProducts.sort((a, b) => a.price - b.price);
    } else if (sort === "high") {
      currentProducts.sort((a, b) => b.price - a.price);
    } else {
      currentProducts = [...products];
    }

    displayProducts();
  }

  function showProduct(index) {
    const product = products[index];

    const message =
      "Hello G12 Market Hub, I am interested in " +
      product.name +
      ". Please send me more information.";

    document.getElementById("modalContent").innerHTML = `
      <div style="font-size:70px;text-align:center;">${product.icon}</div>

      <h2>${product.name}</h2>

      <div class="modal-price">${formatPrice(product.price)}</div>

      <p>${product.description}</p>

      <div class="modal-info">
        <strong>Seller:</strong> ${product.seller}<br>
        <strong>Location:</strong> ${product.location}<br>
        <strong>Category:</strong> ${product.category}
      </div>

      <a
        class="btn"
        style="display:block;text-align:center;text-decoration:none;"
        href="https://wa.me/2348122045380?text=${encodeURIComponent(message)}"
        target="_blank">
        Enquire / Buy on WhatsApp
      </a>
    `;

    document.getElementById("modal").style.display = "flex";
  }

  function closeModal(event) {
    if (!event || event.target.id === "modal") {
      document.getElementById("modal").style.display = "none";
    }
  }

  document.getElementById("searchInput").addEventListener("input", displayProducts);

  displayProducts();
</script>

</body>
</html> 